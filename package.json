{
  "name": "mogobase",
  "type": "module",
  "version": "2.8.0",
  "description": "Lightweight Next.js + MongoDB backend with typed handlers, WebSocket live queries, and opt-in offline / local-first sync.",
  "main": "lib/index.js",
  "types": "types/index.d.ts",
  "author": "SameSame Tech Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samesametech/mogobase.git"
  },
  "homepage": "https://github.com/samesametech/mogobase#readme",
  "bugs": {
    "url": "https://github.com/samesametech/mogobase/issues"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./server": {
      "types": "./types/server/index.d.ts",
      "default": "./lib/server/index.js"
    },
    "./server/sync": {
      "types": "./types/server/sync.d.ts",
      "default": "./lib/server/sync.js"
    },
    "./db": {
      "types": "./types/db/index.d.ts",
      "default": "./lib/db/index.js"
    },
    "./runtime": {
      "types": "./types/runtime/index.d.ts",
      "default": "./lib/runtime/index.js"
    },
    "./client-db": {
      "types": "./types/client/db/index.d.ts",
      "default": "./lib/client/db/index.js"
    },
    "./client-db/watermelon": {
      "types": "./types/client/db/watermelon/index.d.ts",
      "default": "./lib/client/db/watermelon/index.js"
    },
    "./provider": {
      "types": "./types/client/provider.d.ts",
      "default": "./lib/client/provider.js"
    },
    "./sync-types": {
      "types": "./types/client/sync-types.d.ts",
      "default": "./lib/client/sync-types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "types",
    "src/client/hooks",
    "src/client/api",
    "src/client/server.ts",
    "package.json"
  ],
  "peerDependencies": {
    "@nozbe/watermelondb": ">=0.28.0",
    "mongodb": ">=6.0.0",
    "next": ">=14",
    "react": ">=18",
    "rxdb": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "@nozbe/watermelondb": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "rxdb": {
      "optional": true
    }
  },
  "bin": {
    "mogobase": "lib/dev/index.js"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "rm -rf lib types && tsc && tsc-alias && mkdir -p lib/mcp/guides && cp -R src/mcp/guides/. lib/mcp/guides/",
    "start": "node lib/server/start.js",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "prepublish": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.7",
    "@hono/node-ws": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dataloader": "^2.2.3",
    "dotenv": "^17.2.3",
    "hono": "^4.11.3",
    "lodash.merge": "^4.6.2",
    "make-cli": "^6.0.0",
    "react": ">=18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "ws": "^8.20.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@nozbe/watermelondb": "^0.28.0",
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.8",
    "@types/ws": "^8.18.1",
    "mongodb": "^6.21.0",
    "rxdb": "^17.1.0",
    "tsc-alias": "^1.8.16",
    "wrangler": "^4.4.0"
  }
}
