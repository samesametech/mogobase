{
  "name": "mogobase",
  "type": "module",
  "version": "1.0.7",
  "description": "",
  "main": "lib/index.js",
  "types": "types/index.d.ts",
  "author": "SameSame Tech Team",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./server": {
      "types": "./types/server/index.d.ts",
      "default": "./lib/server/index.js"
    },
    "./db": {
      "types": "./types/db/index.d.ts",
      "default": "./lib/db/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "types",
    "package.json"
  ],
  "bin": {
    "mogobase": "lib/dev/index.js"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "rm -rf lib && tsc && tsc-alias",
    "start": "node lib/server/start.js",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.7",
    "@hono/node-ws": "^1.3.0",
    "dataloader": "^2.2.3",
    "dotenv": "^17.2.3",
    "hono": "^4.11.3",
    "lodash.merge": "^4.6.2",
    "make-cli": "^6.0.0",
    "mongodb": "6.8.2",
    "react": "^19.2.3",
    "tsx": "^4.21.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/lodash.merge": "^4.6.9",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.8",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "wrangler": "^4.4.0"
  }
}
